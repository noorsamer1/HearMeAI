# ════════════════════════════════════════════════════════════
#  AI Communication Assistant — Environment Variables
# ════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM (AI responses via OpenRouter) ────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── STT — Speech-to-Text ─────────────────────────────────────
#
#  Option A: Use gpt-audio-mini for BOTH STT and TTS (recommended)
#  → One model, one API key, handles Arabic + English natively
#
#    STT_PROVIDER=gpt-audio-mini
#
#  Option B: Use Whisper via OpenRouter (also just one key)
#
#    STT_PROVIDER=openrouter
#    STT_MODEL=openai/whisper-large-v3-turbo
#
#  Option C: Use OpenAI Whisper directly (needs separate key)
#
#    STT_PROVIDER=openai
#    OPENAI_API_KEY=your_openai_key_here

STT_PROVIDER=openrouter
STT_MODEL=openai/whisper-large-v3-turbo
# Optional: vocabulary hint for Whisper (dialect words). Leave empty for built-in default.
# STT_PROMPT=كيف حالك، شو أخبارك، مرحبا. Hello, how are you.
# When auto STT returns weak Arabic (phonetic mis-hear), retry with this model:
STT_ARABIC_REFINE_ENABLED=true
STT_ARABIC_REFINE_MODEL=openai/gpt-4o-mini-transcribe
# Reject Icelandic-style gibberish instead of posting it as a transcript
STT_REJECT_HALLUCINATIONS=true
OPENAI_API_KEY=

# ── TTS — Text-to-Speech ─────────────────────────────────────
#
#  Option A: Use gpt-audio-mini for BOTH STT and TTS (recommended)
#  → Uses OPENROUTER_API_KEY, no extra setup needed
#
#    TTS_PROVIDER=gpt-audio-mini
#    GPT_AUDIO_VOICE=shimmer        # alloy|echo|fable|onyx|nova|shimmer|ash|coral|sage|verse
#    GPT_AUDIO_FORMAT=mp3           # mp3|opus|wav|pcm16
#
#  Option B: Microsoft Edge TTS (free, no key)
#
#    TTS_PROVIDER=edge
#    TTS_VOICE_AR=ar-SA-HamedNeural   # Saudi male Arabic default
#    TTS_VOICE_EN=en-US-JennyNeural
#
#  Option C: ElevenLabs (best quality, needs key)
#
#    TTS_PROVIDER=elevenlabs
#    ELEVENLABS_API_KEY=your_key

TTS_PROVIDER=edge
GPT_AUDIO_VOICE=shimmer
GPT_AUDIO_FORMAT=mp3
TTS_VOICE_AR=ar-SA-HamedNeural
TTS_VOICE_EN=en-US-JennyNeural
ELEVENLABS_API_KEY=

# ── Database & auth (HearME rooms) ─────────────────────────────
# SQLite (default local) or PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/hearme
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET_KEY=change-me-use-long-random-secret
# Set true to allow DELETE /api/v1/sessions/purge-all (wipes all sessions for all users)
ALLOW_SESSION_PURGE=false
CLASSIFIER_MODEL=openai/gpt-4o-mini
# Optional override; defaults to OPENROUTER_MODEL
ENHANCER_MODEL=

# ── General ───────────────────────────────────────────────────
APP_NAME="AI Communication Assistant"
# DEBUG=true → verbose app logs only (SQL/httpx stay quiet unless SQL_ECHO=true)
DEBUG=false
SQL_ECHO=false
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Camera sentiment (facial expression) ───────────────────────
# huggingface = ViT model trpakov/vit-face-expression (FER2013, recommended)
# heuristic   = lightweight rules only (no torch)
CAMERA_SENTIMENT_PROVIDER=huggingface
CAMERA_SENTIMENT_MODEL=trpakov/vit-face-expression
CAMERA_SENTIMENT_DEVICE=-1
CAMERA_SENTIMENT_FALLBACK_HEURISTIC=true

# ── Redis (optional — matching + multi-instance WebSocket) ────
REDIS_URL=redis://localhost:6379
USE_REDIS=false
